}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"KSubsets", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"ToExact", ",", 
       RowBox[{"Centroid", "/@", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Polyhedron", "[", "Icosahedron", "]"}], "]"}]}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "2"}], "]"}]}], ";"}], "\n", 
