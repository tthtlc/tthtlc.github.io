  RowBox[{
   RowBox[{"diags1", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"e", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Norm", "[", "#", "]"}], "-", 
          RowBox[{"Max", "[", "norm", "]"}]}], "]"}], "<", 
