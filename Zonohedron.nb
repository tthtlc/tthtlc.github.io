Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"KSubsets", "[", 
    RowBox[{
     RowBox[{"PolyhedronVertices", "[", "Icosahedron", "]"}], ",", "2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{"Norm", "/@", "e"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diags1", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"e", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Norm", "[", "#", "]"}], "-", 
         RowBox[{"Max", "[", "norm", "]"}]}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], "&"}]}], "]"}]}], ";"}]}], "Input",Expression\
UUID->"653dd126-b25d-4aa5-b6c1-e7be634b8c99"],

