Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"KSubsets", "[", 
    RowBox[{
     RowBox[{"PolyhedronVertices", "[", "Icosahedron", "]"}], ",", "2"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{"Norm", "/@", "e"}]}], ";"}], "\n", 
