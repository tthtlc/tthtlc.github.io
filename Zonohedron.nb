            RowBox[{"PolyhedronVertices", "[", "Icosahedron", "]"}]}], 
           "]"}]}], ")"}]}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "2"}], "]"}]}], ";"}], "\n", 
