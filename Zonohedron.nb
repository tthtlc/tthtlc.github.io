         RowBox[{"Norm", "[", "#", "]"}], "-", 
         RowBox[{"Max", "[", "norm", "]"}]}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], "&"}]}], "]"}]}], ";"}]}], "Input",Expression\
