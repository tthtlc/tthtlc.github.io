 RowBox[{"{", 
  RowBox[{
   RowBox[{"2.469999999999999`", " ", "Second"}], ",", "6"}], "}"}]], "Output",\
ExpressionUUID->"c17963da-be51-4268-8563-36d6217c9732"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"e", "=", 
   RowBox[{"KSubsets", "[", 
    RowBox[{
     RowBox[{"Map", "[", 
      RowBox[{"ToExact", ",", 
       RowBox[{"Midpoint", "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"PolyhedronEdges", "[", "Icosahedron", "]"}], "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Range", "[", "12", "]"}], "\[Rule]", 
            RowBox[{"PolyhedronVertices", "[", "Icosahedron", "]"}]}], 
           "]"}]}], ")"}]}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}], ",", "2"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"norm", "=", 
   RowBox[{"Norm", "/@", "e"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diags2", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"e", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Norm", "[", "#", "]"}], "-", 
         RowBox[{"Max", "[", "norm", "]"}]}], "]"}], "<", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], "&"}]}], "]"}]}], ";"}]}], "Input",Expression\
UUID->"853483bf-d92d-45a5-b98a-ba596ba02425"],

