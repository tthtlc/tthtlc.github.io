Cell[CellGroupData[{

Cell["Cube Zonification", "Section",ExpressionUUID->"e24b5b55-d592-4796-958e-8b90035a49a5"],

Cell["Truncated Small Rhombicuboctahedron", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"8a7ac5a2-c3d9-4951-ab5f-0b95de9c32f9"],

Cell["\<\
This is the Minkowski sum of a cube, a truncated octahedron, and a rhombic \
dodecahedron.  It has as its generators the 13 axes of symmetry of a cube. \
Some of the octagonal faces are non-regular. (Eppstein)\
\>", "Text",
 Evaluatable->False,
 AspectRatioFixed->
  True,ExpressionUUID->"b7c675fd-84e8-4ffe-8ad3-32a7d5fa1f62"],

