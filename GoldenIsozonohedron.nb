Cell[CellGroupData[{

Cell["Isozonohedra", "Section",ExpressionUUID->"991e2aac-803b-417c-91ca-84985c08da07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"PolyhedronFaces", "[", "poly_Polyhedron", "]"}], ":=", 
  RowBox[{"poly", "[", 
   RowBox[{"[", "2", "]"}], "]"}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"f93ad600-909d-427f-a501-5162eddb03af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GoldenIsozonohedronQ", "[", 
   RowBox[{"poly_Polyhedron", ",", 
    RowBox[{"prec_:", "20"}], ",", 
    RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"verts", "=", 
       RowBox[{"PolyhedronCoordinates", "[", "poly", "]"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"faces", "=", 
       RowBox[{"PolyhedronFaces", "[", "poly", "]"}]}], ",", 
      "\[IndentingNewLine]", "diagonals", ",", "\[IndentingNewLine]", 
      RowBox[{"debug", "=", 
       RowBox[{
        RowBox[{"Debug", "/.", 
         RowBox[{"{", "opts", "}"}]}], "/.", 
        RowBox[{"Debug", "\[Rule]", "False"}]}]}]}], "\[IndentingNewLine]", 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Union", "[", 
         RowBox[{"Length", "/@", "faces"}], "]"}], "=!=", 
        RowBox[{"{", "4", "}"}]}], ",", 
       RowBox[{"Return", "[", "False", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"debug", ",", 
       RowBox[{"Print", "[", "faces", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"diagonals", "=", 
      RowBox[{"Quiet", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"EuclideanDistance", "@@", "#"}], "&"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"Partition", "[", 
               RowBox[{"#", ",", "2"}], "]"}], "]"}], "&"}], "/@", "faces"}], 
           "/.", 
           RowBox[{"i_Integer", "\[RuleDelayed]", 
            RowBox[{"verts", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"N", "::", "meprec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{"debug", ",", 
       RowBox[{"Print", "[", "diagonals", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Equal", "@@", 
      RowBox[{"Prepend", "[", 
       RowBox[{
        RowBox[{"Divide", "@@@", 
         RowBox[{"(", 
          RowBox[{"Sort", "/@", 
           RowBox[{"N", "[", 
            RowBox[{"diagonals", ",", "prec"}], "]"}]}], ")"}]}], ",", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"1", "/", "GoldenRatio"}], ",", "prec"}], "]"}]}], 
       "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"0b0a24c5-1304-401f-a635-e72f1b39396c"],

Cell["\<\
Note: these include RhombicHexecontahedron, which fails to be a zonohedron \
because its faces are not centrally symmetric\
\>", "Text",ExpressionUUID->"16b64ab3-fad6-4290-845d-320d7e120fd1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"giz", "=", 
  RowBox[{"Monitor", "[", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"PolyhedronData", "[", "All", "]"}], ",", 
      RowBox[{
       RowBox[{"Check", "[", 
        RowBox[{
         RowBox[{"GoldenIsozonohedronQ", "[", 
          RowBox[{"PolyhedronData", "[", 
           RowBox[{
            RowBox[{"poly", "=", "#"}], ",", "\"\<Polyhedron\>\""}], "]"}], 
          "]"}], ",", 
         RowBox[{"Print", "[", "#", "]"}]}], "]"}], "&"}]}], "]"}], ",", 
    "poly"}], "]"}]}]], "Input",
 CellLabel->"In[5]:=",ExpressionUUID->"9317b114-704f-441d-b358-def62fb34f45"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"AcuteGoldenRhombohedron\"\>", 
   ",", "\<\"BilinskiDodecahedron\"\>", 
   ",", "\<\"ObtuseGoldenRhombohedron\"\>", 
   ",", "\<\"RhombicHexecontahedron\"\>", ",", "\<\"RhombicIcosahedron\"\>", 
   ",", "\<\"RhombicTriacontahedron\"\>"}], "}"}]], "Output",
 CellLabel->"Out[5]=",ExpressionUUID->"cffc0784-37dd-4214-90ce-8871003e2938"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TextGrid", "[", 
  RowBox[{
   RowBox[{"Sort", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PolyhedronData", "[", 
         RowBox[{"#", ",", "\"\<FaceCount\>\""}], "]"}], ",", "#"}], "}"}], 
      "&"}], "/@", "giz"}], "]"}], ",", 
   RowBox[{"Alignment", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Decimal", ",", "Left"}], "}"}], "}"}]}], ",", 
   RowBox[{"Dividers", "\[Rule]", "All"}]}], "]"}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"86e490b5-9097-4bdb-87c3-97a5af5d1070"],

Cell[BoxData[
 TagBox[GridBox[{
    {"6", Cell[
     "AcuteGoldenRhombohedron",ExpressionUUID->
      "f1d6226d-3c0d-41d1-b03c-3bbe63b607d7"]},
    {"6", Cell[
     "ObtuseGoldenRhombohedron",ExpressionUUID->
      "4da7ba47-e72d-4e99-b4b0-e88df8ded60b"]},
    {"12", Cell[
     "BilinskiDodecahedron",ExpressionUUID->
      "f952b503-5cc2-40fb-a7d8-70ca52153bc5"]},
    {"20", Cell[
     "RhombicIcosahedron",ExpressionUUID->
      "2f054775-f52d-42ff-8b8a-8c203e4e1e30"]},
    {"30", Cell[
     "RhombicTriacontahedron",ExpressionUUID->
      "0354f0e2-3e77-4d48-8d98-187b43ae01da"]},
    {"60", Cell[
     "RhombicHexecontahedron",ExpressionUUID->
      "7b4a6674-e8a6-4381-8ad0-2a14ff0ce860"]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {Decimal, Left}},
   GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "TextGrid"]], "Output",
 CellLabel->"Out[8]=",ExpressionUUID->"adc8a9b1-ca30-4fc9-92d7-c7982e395b8a"]
