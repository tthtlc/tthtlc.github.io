Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"rotate", " ", 
    RowBox[{"1", "/", "10"}], " ", "of", " ", "a", " ", "turn", " ", "and", 
    " ", "flip", " ", "z"}], "*)"}], 
  RowBox[{
   RowBox[{"invertedPoly", "[", "l_List", "]"}], ":=", 
   RowBox[{"Polygon", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Append", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", 
              RowBox[{"Pi", "/", "5"}], "]"}], ",", 
             RowBox[{"Sin", "[", 
              RowBox[{"Pi", "/", "5"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", 
               RowBox[{"Pi", "/", "5"}], "]"}]}], ",", 
             RowBox[{"Cos", "[", 
              RowBox[{"Pi", "/", "5"}], "]"}]}], "}"}]}], "}"}], ".", 
         RowBox[{"Take", "[", 
          RowBox[{"#", ",", "2"}], "]"}]}], ",", 
        RowBox[{"-", 
         RowBox[{"Last", "[", "#", "]"}]}]}], "]"}], "&"}], "/@", "l"}], 
    "]"}]}]}]], "Input",ExpressionUUID->"d23c3a28-0442-4d42-a770-\
853c4c12e7f7"],

